<?xml version="1.0" encoding="UTF-8"?>
<!-- concrete part only (SOAP 1.2); abstract definitions come from wsdl:import -->
<wsdl:definitions name="Echo"
    targetNamespace="http://example.com/echo/service"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
    xmlns:svc="http://example.com/echo/service"
    xmlns:abs="http://example.com/echo/abstract">
  <wsdl:import namespace="http://example.com/echo/abstract" location="wsdlimport-abstract.wsdl"/>
  <wsdl:binding name="EchoBinding12" type="abs:EchoPortType">
    <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Echo">
      <soap12:operation soapAction="urn:echo" soapActionRequired="true"/>
      <wsdl:input><soap12:body use="literal"/></wsdl:input>
      <wsdl:output><soap12:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="EchoService">
    <wsdl:port name="EchoPort" binding="svc:EchoBinding12">
      <soap12:address location="http://localhost/echo"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
